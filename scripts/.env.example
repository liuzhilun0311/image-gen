# Configure your own drawing-service URL and API key.
GPT_IMAGE2_BASE_URL=https://code.heihuzi.ai/
GPT_IMAGE2_API_KEY=
GPT_IMAGE2_MODEL=gpt-image-2.5-flare
GPT_IMAGE2_MODE=current
GPT_IMAGE2_N=1
GPT_IMAGE2_RESOLUTION=1k
GPT_IMAGE2_ASPECT_RATIO=1:1
