# API Key
# FLARE_SUNBURST_API_KEY：Flare、Sunburst 使用的 API Key。
# BANANA_API_KEY：Banana 使用的 API Key。
FLARE_SUNBURST_API_KEY=
BANANA_API_KEY=

# 运行配置
IMAGE_GEN_BASE_URL=https://code.heihuzi.ai/
IMAGE_GEN_MODE=current
IMAGE_GEN_TIMEOUT_MS=240000
IMAGE_GEN_MAX_RETRIES=2
IMAGE_GEN_MIN_INTERVAL_MS=0
IMAGE_GEN_CONCURRENCY=2
IMAGE_GEN_PRIVATE_METADATA=false

# 参数说明
# IMAGE_GEN_BASE_URL：固定服务平台地址，不要修改。
# IMAGE_GEN_MODE：请求模式，目前填写 current。
# IMAGE_GEN_TIMEOUT_MS：单次请求超时时间，单位为毫秒。
# IMAGE_GEN_MAX_RETRIES：仅 429 限流时的最大重试次数，范围 0–10。
# IMAGE_GEN_MIN_INTERVAL_MS：请求启动间隔，单位为毫秒；0 表示不限制。
# IMAGE_GEN_CONCURRENCY：Banana 多图请求并发数，范围 1–4。
# IMAGE_GEN_PRIVATE_METADATA：是否隐藏记录中的本机路径；true 隐藏，false 保留。
